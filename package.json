{
  "name": "ml-talk-demo",
  "version": "1.0.0",
  "main": "index.ts",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@tensorflow-models/body-pix": "2.2.1",
    "@tensorflow-models/coco-ssd": "2.2.3",
    "@tensorflow/tfjs-backend-cpu": "4.22.0",
    "@tensorflow/tfjs-backend-webgl": "4.22.0",
    "@tensorflow/tfjs-converter": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "@types/node": "24.13.4",
    "@types/reveal.js": "^5.2.0",
    "@types/stats.js": "0.17.4",
    "reveal.js": "6.0.1",
    "stats.js": "0.17.0",
    "typescript": "7.0.2"
  },
  "scripts": {
    "dev": "bun --watch --hot --port 5000 index.html",
    "build": "bun build --outdir dist index.html demo1.html demo2.html talk.html homeserver.html",
    "cleanup": "rm -rf .cache",
    "start": "bun --port 5000 dist/index.html",
    "lint": "biome check --write src/*.ts",
    "typecheck": "tsc --noEmit",
    "certbot": "certbot certonly --manual -d ml-demo.philiplehmann.ch --work-dir certbot/work --config-dir certbot/config --logs-dir certbot/logs --preferred-challenges dns"
  },
  "engines": {
    "bun": "1.4.2",
    "node": "24.21.0"
  },
  "packageManager": "bun@1.4.2"
}
